# Copie para .env.local e preencha somente o banco local.
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:54330/banco_local
ERP_FEATURE_FLAG=true
ERP_BACKEND_TOKEN=mesmo-token-configurado-no-suprimentos
OPEN_BROWSER=1
PORT=8010
MES_LEGACY_SCHEMA_AUTO_MIGRATE=true
ERP_MES_LEGACY_UPLOAD_ENABLED=true
MES_BOOTSTRAP_ADMIN_USER=
MES_BOOTSTRAP_ADMIN_PASSWORD=
