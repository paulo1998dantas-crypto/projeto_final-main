DATABASE_URL=postgresql://usuario:senha@host:5432/banco
ERP_FEATURE_FLAG=false
ERP_BACKEND_TOKEN=troque-por-token-entre-servicos
# Mantenha legacy até aplicar e validar a migration RBAC compartilhada.
MES_AUTH_MODE=legacy
MES_USER_MANAGEMENT_URL=https://moduloestoque-cni2.onrender.com/usuarios
OPEN_BROWSER=0
MES_LEGACY_SCHEMA_AUTO_MIGRATE=false
# Mantenha true apenas enquanto o banco legado continuar como fonte operacional.
ERP_MES_LEGACY_UPLOAD_ENABLED=false
# O bootstrap cria o usuário somente se ele ainda não existir; nunca redefine senha.
MES_BOOTSTRAP_ADMIN_USER=
MES_BOOTSTRAP_ADMIN_PASSWORD=

# Usadas somente pelo relatório de reconciliação, nunca no aplicativo web.
# Defina-as apenas na sessão do terminal/staging; não grave credenciais no Git.
MES_LEGACY_DATABASE_URL=
ERP_TARGET_DATABASE_URL=
